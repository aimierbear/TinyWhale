{
  "schema_version": 1,
  "runtime_id": "grok",
  "kind": "owned_claude_hooks",
  "target": "~/.grok/hooks/fractal-agent.json",
  "owner_id": "ai.fractal.grok.v1",
  "retire_commands": [],
  "events": [
    {"name": "SessionStart", "timeout": 10},
    {"name": "PreToolUse", "matcher": "Edit|Write", "timeout": 10},
    {"name": "PostToolUse", "matcher": "Edit|Write", "timeout": 10},
    {"name": "PostToolUseFailure", "matcher": "Edit|Write", "timeout": 10},
    {"name": "Stop", "timeout": 10}
  ]
}
