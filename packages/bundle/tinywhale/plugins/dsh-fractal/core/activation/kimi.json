{
  "schema_version": 1,
  "runtime_id": "kimi",
  "kind": "kimi_toml",
  "target": "~/.kimi-code/config.toml",
  "owner_id": "ai.fractal.kimi.v1",
  "retire_commands": [
    "bash ~/.kimi-code/hooks/fractal-dirty-track.sh",
    "bash ~/.kimi-code/hooks/fractal-sync-remind.sh"
  ],
  "events": [
    {"name": "SessionStart", "timeout": 10},
    {"name": "PreToolUse", "matcher": "Edit|Write", "timeout": 10},
    {"name": "PostToolUse", "matcher": "Edit|Write", "timeout": 10},
    {"name": "Stop", "timeout": 10}
  ]
}
